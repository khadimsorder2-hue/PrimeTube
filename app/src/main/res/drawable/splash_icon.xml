<?xml version="1.0" encoding="utf-8"?>
<!-- PrimeTube: YouTube-style splash icon - white play triangle on red background.
     The scaleGroup wrapper is required by splash_anim.xml (animated vector). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="64dp"
    android:height="64dp"
    android:viewportWidth="1280"
    android:viewportHeight="1280">

    <group
        android:name="scaleGroup"
        android:scaleX="0.5"
        android:scaleY="0.5"
        android:pivotX="640"
        android:pivotY="640">
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M240,305 L240,975 Q240,1075 328,1027 L952,688 Q1040,640 952,592 L328,253 Q240,205 240,305 Z"/>
    </group>

</vector>
