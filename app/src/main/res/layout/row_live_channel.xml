<?xml version="1.0" encoding="utf-8"?>
<!-- PrimeTube: Live TV channel card - premium dark design, numbered, logo -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/channelCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="#141414"
    app:rippleColor="#33FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#2A2A2A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="94dp"
            android:background="#0A0A0A">

            <ImageView
                android:id="@+id/channelLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:contentDescription="@string/prime_live_tv"
                tools:src="@drawable/ic_nav_live" />

            <View
                android:layout_width="match_parent"
                android:layout_height="34dp"
                android:layout_gravity="bottom"
                android:background="@drawable/prime_live_scrim" />

            <TextView
                android:id="@+id/channelNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="7dp"
                android:background="@drawable/prime_live_number_bg"
                android:elevation="3dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2.5dp"
                android:shadowColor="#AA000000"
                android:shadowDy="1"
                android:shadowRadius="3"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="01" />

            <ImageView
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:layout_gravity="top|end"
                android:layout_margin="9dp"
                android:contentDescription="@string/prime_live_tv"
                android:src="@drawable/prime_live_dot"
                android:elevation="3dp" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="10dp"
            android:paddingEnd="8dp"
            android:paddingTop="7dp"
            android:paddingBottom="9dp">

            <TextView
                android:id="@+id/channelName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="12.5sp"
                android:textStyle="bold"
                tools:text="T Sports HD" />

            <TextView
                android:id="@+id/channelGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#8F8F8F"
                android:textSize="10sp"
                tools:text="Sports" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
