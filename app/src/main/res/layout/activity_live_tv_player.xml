<?xml version="1.0" encoding="utf-8"?>
<!-- PrimeTube: dedicated full-screen player for Live TV (IPTV) channels -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/livePlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:surface_type="surface_view"
        app:use_controller="true" />

    <!-- minimal top bar: back + channel name (over the controller) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#66000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/liveBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/prime_live_tv"
            android:padding="8dp"
            android:src="@drawable/prime_live_back"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/liveTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowRadius="4"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/liveLogo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/prime_live_tv"
            android:padding="2dp" />
    </LinearLayout>

    <!-- error overlay with retry -->
    <LinearLayout
        android:id="@+id/livePlayerError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC101010"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prime_live_player_error"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/livePlayerRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/retry" />
    </LinearLayout>
</FrameLayout>
