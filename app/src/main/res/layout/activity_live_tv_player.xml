<?xml version="1.0" encoding="utf-8"?>
<!-- PrimeTube: YouTube-like full-screen player for Live TV (IPTV) channels -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/livePlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:resize_mode="fill"
        app:show_buffering="when_playing"
        app:surface_type="surface_view"
        app:use_controller="true" />

    <!-- top bar row 1: back + channel name + logo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="6dp"
        android:background="#44000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="10dp"
        android:paddingVertical="6dp">

        <ImageView
            android:id="@+id/liveBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="@string/prime_live_tv"
            android:padding="8dp"
            android:src="@drawable/prime_live_back"
            app:tint="@android:color/white" />

        <TextView
            android:id="@+id/liveTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:shadowColor="#B3000000"
            android:shadowRadius="4"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- PrimeTube: red LIVE badge like YouTube -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/prime_live_number_bg"
            android:paddingHorizontal="7dp"
            android:paddingVertical="2dp"
            android:text="@string/prime_live_badge"
            android:textColor="@android:color/white"
            android:textSize="10sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/liveLogo"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:contentDescription="@string/prime_live_tv"
            android:padding="2dp" />
    </LinearLayout>

    <!-- top bar row 2: prev / next / fill / quality / playlist -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="56dp"
        android:layout_marginEnd="6dp"
        android:background="#59000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton
            android:id="@+id/livePrev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/prime_live_prev_channel"
            android:src="@drawable/ic_prev"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/liveNext"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/prime_live_next_channel"
            android:src="@drawable/ic_next"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/liveFill"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/prime_live_fill"
            android:src="@drawable/ic_fill"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/liveQuality"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/quality"
            android:src="@drawable/ic_hd"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/liveQueue"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/prime_live_channels"
            android:src="@drawable/ic_queue"
            app:tint="@android:color/white" />
    </LinearLayout>

    <!-- PrimeTube: brightness / volume gesture indicator pill -->
    <TextView
        android:id="@+id/liveGesturePill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/prime_gesture_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Brightness 50%" />

    <!-- PrimeTube: channels side panel (translucent, close button) -->
    <FrameLayout
        android:id="@+id/liveQueueRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/liveQueuePanel"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:layout_gravity="end|top"
            android:background="@drawable/prime_queue_panel_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/prime_live_channels"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/liveQueueClose"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/tooltip_close"
                    android:src="@drawable/ic_close"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/liveQueueRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="24dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- error overlay with retry -->
    <LinearLayout
        android:id="@+id/livePlayerError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC101010"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prime_live_player_error"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/livePlayerRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/retry" />
    </LinearLayout>

    <!-- PrimeTube: no internet overlay - no play without internet -->
    <LinearLayout
        android:id="@+id/liveNoInternet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC101010"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="26dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.6"
            android:contentDescription="@string/prime_live_no_internet"
            android:src="@drawable/ic_nav_live"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/prime_live_no_internet"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/liveNoInternetRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/retry" />
    </LinearLayout>
</FrameLayout>
