<?xml version="1.0" encoding="utf-8"?>
<!-- PrimeTube: YouTube-like full-screen player for Live TV (IPTV) channels.
     Nothing sits on the video: one tap reveals all controls for 5 s, then
     everything auto-hides again. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    android:keepScreenOn="true">

    <androidx.media3.ui.PlayerView
        android:id="@+id/livePlayerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        app:resize_mode="fill"
        app:show_buffering="never"
        app:surface_type="surface_view"
        app:use_controller="false" />

    <!-- PrimeTube: simple buffering - a small plain ring that only shows
         while the channel is buffering and auto-hides again -->
    <com.google.android.material.loadingindicator.LoadingIndicator
        android:id="@+id/liveBuffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0"
        android:elevation="6dp"
        android:indeterminate="true"
        android:visibility="invisible"
        app:indicatorColor="#FF0033"
        app:indicatorSize="36dp" />

    <!-- PrimeTube: the full control overlay, hidden until the user taps -->
    <FrameLayout
        android:id="@+id/liveControlsRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- PrimeTube: click sink FIRST (behind everything) so taps on empty
             areas close the overlay while buttons on top keep working -->
        <View
            android:id="@+id/liveControlsSink"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true" />

        <!-- top scrim + row: back, logo, title, LIVE badge -->
        <View
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="top"
            android:background="@drawable/player_scrim_top" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:id="@+id/liveBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/prime_live_tv"
                android:padding="9dp"
                android:src="@drawable/prime_live_back"
                app:tint="@android:color/white" />

            <ImageView
                android:id="@+id/liveLogo"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/prime_chip_bg"
                android:contentDescription="@string/prime_live_tv"
                android:padding="4dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/liveTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#B3000000"
                android:shadowRadius="4"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <!-- PrimeTube: red LIVE badge like YouTube -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/prime_live_number_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="@string/prime_live_badge"
                android:textColor="@android:color/white"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- PrimeTube: prev / play / next dead-center like the YouTube player -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/livePrev"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/prime_chip_bg"
                android:contentDescription="@string/prime_live_prev_channel"
                android:padding="14dp"
                android:src="@drawable/ic_prev"
                app:tint="@android:color/white" />

            <ImageView
                android:id="@+id/liveCenterPlay"
                android:layout_width="84dp"
                android:layout_height="84dp"
                android:layout_marginHorizontal="24dp"
                android:background="@drawable/prime_chip_bg"
                android:contentDescription="@string/pause"
                android:padding="20dp"
                android:src="@drawable/ic_pause_filled"
                app:tint="@android:color/white" />

            <ImageView
                android:id="@+id/liveNext"
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:background="@drawable/prime_chip_bg"
                android:contentDescription="@string/prime_live_next_channel"
                android:padding="14dp"
                android:src="@drawable/ic_next"
                app:tint="@android:color/white" />
        </LinearLayout>

        <!-- bottom scrim + chips: fill / quality / channels / sleep -->
        <View
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_gravity="bottom"
            android:background="@drawable/player_scrim_bottom" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingBottom="22dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/liveFillChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/prime_chip_bg"
                    android:contentDescription="@string/prime_live_fill"
                    android:drawablePadding="6dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="@string/prime_live_fill"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_fill"
                    app:drawableTint="@android:color/white" />

                <TextView
                    android:id="@+id/liveQualityChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/prime_chip_bg"
                    android:contentDescription="@string/quality"
                    android:drawablePadding="6dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="@string/prime_live_auto"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_hd"
                    app:drawableTint="@android:color/white" />

                <TextView
                    android:id="@+id/liveQueueChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/prime_chip_bg"
                    android:contentDescription="@string/prime_live_channels"
                    android:drawablePadding="6dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="@string/prime_live_channels"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_queue"
                    app:drawableTint="@android:color/white" />

                <!-- PrimeTube: sleep timer chip -->
                <TextView
                    android:id="@+id/liveSleepChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:background="@drawable/prime_chip_bg"
                    android:contentDescription="@string/prime_sleep_title"
                    android:drawablePadding="6dp"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="7dp"
                    android:text="@string/prime_sleep_chip"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:drawableStartCompat="@drawable/ic_sleep"
                    app:drawableTint="@android:color/white" />

            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <!-- PrimeTube: brightness / volume gesture indicator pill -->
    <TextView
        android:id="@+id/liveGesturePill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/prime_gesture_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@android:color/white"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        tools:text="Brightness 50%" />

    <!-- PrimeTube: Live TV PiP headphone - the ONLY in-window button while in
         picture-in-picture. Tapping it leaves the PiP window and keeps the
         channel's AUDIO playing in the background (video track disabled).
         It sits at the very BOTTOM-RIGHT corner so it can never overlap the
         system's close (X) button at the top. -->
    <ImageView
        android:id="@+id/livePipAudioBtn"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/prime_chip_bg"
        android:contentDescription="@string/prime_pip_audio_bg"
        android:padding="8dp"
        android:src="@drawable/ic_headphones"
        android:visibility="gone"
        app:tint="@android:color/white" />

    <!-- PrimeTube: channels side panel (transparent, close button) -->
    <FrameLayout
        android:id="@+id/liveQueueRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/liveQueuePanel"
            android:layout_width="200dp"
            android:layout_height="match_parent"
            android:layout_gravity="end|top"
            android:background="@drawable/prime_queue_panel_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp"
                android:paddingVertical="6dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/prime_live_channels"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/liveQueueClose"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/tooltip_close"
                    android:src="@drawable/ic_close"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <!-- PrimeTube: search inside the channels playlist -->
            <EditText
                android:id="@+id/liveQueueSearch"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="2dp"
                android:background="@drawable/prime_search_bg"
                android:contentDescription="@string/prime_search_hint"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="6dp"
                android:drawableTint="#CCFFFFFF"
                android:hint="@string/prime_search_hint"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="10dp"
                android:textColor="@android:color/white"
                android:textColorHint="#88FFFFFF"
                android:textSize="12sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/liveQueueRecycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="24dp" />
        </LinearLayout>
    </FrameLayout>

    <!-- error overlay with retry -->
    <LinearLayout
        android:id="@+id/livePlayerError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC101010"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/prime_live_player_error"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <!-- PrimeTube: technical reason (e.g. ERROR_CODE_IO_...) - helps to
             debug channels that refuse to play on some devices (TV boxes) -->
        <TextView
            android:id="@+id/liveErrorDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.7"
            android:gravity="center"
            android:maxWidth="280dp"
            android:textColor="@android:color/white"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="ERROR_CODE_IO_NETWORK_CONNECTION_FAILED" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/livePlayerRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/retry" />
    </LinearLayout>

    <!-- PrimeTube: no internet overlay - no play without internet -->
    <LinearLayout
        android:id="@+id/liveNoInternet"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="#CC101010"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="26dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:alpha="0.6"
            android:contentDescription="@string/prime_live_no_internet"
            android:src="@drawable/ic_nav_live"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/prime_live_no_internet"
            android:textColor="@android:color/white"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/liveNoInternetRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/retry" />
    </LinearLayout>
</FrameLayout>
