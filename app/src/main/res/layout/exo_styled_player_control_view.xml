<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:animateLayoutChanges="true"
        android:background="@drawable/player_scrim_top"
        android:orientation="vertical"
        android:paddingHorizontal="5dp"
        android:paddingTop="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layoutDirection="ltr">

            <!-- PrimeTube: clean premium top bar - video title on the left,
                 only the options (settings) button on the right -->
            <TextView
                android:id="@+id/exo_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginHorizontal="14dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:shadowColor="#AA000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="4"
                android:textColor="@android:color/white"
                android:textSize="18sp"
                android:textStyle="bold"
                android:visibility="invisible" />

            <LinearLayout
                android:id="@+id/exo_top_bar_right"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layoutDirection="ltr">

                <!-- PrimeTube: direct quality / autoplay / speed controls in the top bar -->

                <ImageButton
                    android:id="@+id/autoplay_toggle"
                    style="@style/PlayerControlTop"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/ic_play_circle"
                    android:tooltipText="@string/player_autoplay"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/quality_toggle"
                    style="@style/PlayerControlTop"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/ic_hd"
                    android:tooltipText="@string/quality"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/speed_top"
                    style="@style/PlayerControlTop"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/ic_speed"
                    android:tooltipText="@string/playback_speed"
                    app:tint="@android:color/white" />

                <!-- PrimeTube: queue (playlist) button back in the top bar -->
                <ImageButton
                    android:id="@+id/queue_toggle"
                    style="@style/PlayerControlTop"
                    android:layout_marginEnd="2dp"
                    android:src="@drawable/ic_queue"
                    android:tooltipText="@string/queue"
                    app:tint="@android:color/white" />

                <ImageButton
                    android:id="@+id/toggle_options"
                    style="@style/PlayerControlTop"
                    android:src="@drawable/ic_player_settings"
                    android:tooltipText="@string/tooltip_options"
                    app:tint="@android:color/white" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@id/exo_center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@android:color/transparent"
        android:gravity="center"
        android:padding="20dp"
        android:layoutDirection="ltr">

        <include
            android:id="@+id/seek_button_rewind"
            layout="@layout/seek_button_rewind"
            android:visibility="invisible"
            tools:visibility="visible" />

        <ImageView
            android:id="@+id/skip_prev"
            style="@style/PlayerControlCenter"
            android:background="?android:selectableItemBackgroundBorderless"
            android:src="@drawable/ic_prev"
            android:visibility="invisible"
            app:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/playPauseBTN"
            style="@style/ExoStyledControls.Button.Center.PlayPause"
            android:layout_marginHorizontal="10dp"
            android:background="@drawable/player_center_btn_bg"
            android:padding="14dp"
            android:src="@drawable/ic_play"
            app:tint="@android:color/white" />

        <ImageView
            android:id="@+id/skip_next"
            style="@style/PlayerControlCenter"
            android:background="?android:selectableItemBackgroundBorderless"
            android:src="@drawable/ic_next"
            android:visibility="invisible"
            app:tint="@android:color/white" />

        <include
            android:id="@+id/seek_button_forward"
            layout="@layout/seek_button_forward"
            android:visibility="invisible"
            tools:visibility="visible" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginTop="10dp"
        android:background="@drawable/player_scrim_bottom"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/seekbar_preview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:translationY="30dp"
            android:translationZ="1dp"
            android:visibility="gone">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/seekbar_preview_image"
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Small" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/previewProgressIndicator"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="?shapeCornerSizeSmall"
                android:layout_gravity="bottom"
                android:indeterminate="true"
                android:visibility="invisible"
                app:trackThickness="2.5dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="5dp"
                android:padding="5dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/seekbar_preview_position"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="5dp" />

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="-6dp"
            android:baselineAligned="false"
            android:paddingStart="10dp"
            android:paddingEnd="20dp">

            <LinearLayout
                android:id="@id/exo_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="10dp">

                <TextView
                    android:id="@+id/position"
                    style="@style/TimeString"
                    android:text="00:00"
                    tools:ignore="HardcodedText" />

                <TextView
                    style="@style/TimeString"
                    android:text="  •  "
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/duration"
                    style="@style/TimeString"
                    android:text="00:00"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/timeLeft"
                    style="@style/TimeString"
                    android:text="00:00"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />

            </LinearLayout>

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/chapter_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:visibility="gone"
                    app:drawableEndCompat="@drawable/ic_arrow_right"
                    app:drawableTint="@android:color/white"
                    tools:drawableTint="?colorControlNormal"
                    tools:text="some overflowing text that takes too much space"
                    tools:textColor="@android:color/black"
                    tools:visibility="visible" />

            </FrameLayout>

            <LinearLayout
                android:id="@id/exo_basic_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/speed_toggle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/prime_gesture_pill"
                    android:fontFamily="sans-serif-medium"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="@string/prime_speed_1x"
                    android:textColor="@android:color/white"
                    android:textSize="13sp" />

                <ImageButton
                    android:id="@+id/fullscreen"
                    style="@style/PlayerControlBottom"
                    android:src="@drawable/ic_fullscreen"
                    android:tooltipText="@string/tooltip_fullscreen"
                    app:tint="@android:color/white" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginHorizontal="10dp"
            android:translationZ="10dp">

            <com.github.libretube.ui.views.ChapterTimeBar
                android:id="@+id/exo_progress"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="6dp"
                app:bar_height="3dp"
                app:played_color="?attr/colorSecondary"
                app:scrubber_color="?attr/colorSecondary"
                app:scrubber_dragged_size="16dp"
                app:scrubber_enabled_size="12dp"
                app:touch_target_height="35dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- PrimeTube: YouTube-style queue side panel - translucent, close button,
         at most ~20% of the screen, overlays the right side of the player -->
    <FrameLayout
        android:id="@+id/queue_panel_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/queue_panel"
            android:layout_width="180dp"
            android:layout_height="match_parent"
            android:layout_gravity="end|top"
            android:layout_marginTop="52dp"
            android:background="@drawable/prime_queue_panel_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="6dp"
                android:paddingVertical="6dp">

                <TextView
                    android:id="@+id/queue_panel_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/prime_queue_title"
                    android:textColor="@android:color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/queue_panel_close"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/tooltip_close"
                    android:src="@drawable/ic_close"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/queue_panel_recycler"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingBottom="70dp" />
        </LinearLayout>
    </FrameLayout>

</merge>
